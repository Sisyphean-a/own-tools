{
  "name": "obsidian-ai-rewrite",
  "version": "0.4.0",
  "private": true,
  "description": "Rewrite a selected passage in Obsidian with AI",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint .",
    "test": "node esbuild.test.mjs && node --test ../../.tmp/obsidian-ai-rewrite-*.test.mjs"
  },
  "license": "0-BSD",
  "devDependencies": {
    "@codemirror/commands": "6.8.1",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "obsidian": "latest",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1"
  }
}
